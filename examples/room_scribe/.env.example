# Your LiveKit Cloud project: https://cloud.livekit.io -> Settings -> Keys.
# Enter the same three values in Parivox under Settings -> LiveKit Cloud Configuration.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The worker name. Must match "Self-hosted worker name" on the Parivox agent.
# Use a different one for your laptop and for production; see docs/local-development.md.
AGENT_NAME=room-scribe-dev

# Optional: LiveKit Inference models (https://docs.livekit.io/agents/models/).
# SCRIBE_LLM=openai/gpt-4.1-mini
# SCRIBE_STT=deepgram/nova-3
# SCRIBE_TTS=cartesia/sonic-3
